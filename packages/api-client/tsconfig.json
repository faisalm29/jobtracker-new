{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "typeRoots": ["./node_modules/@types", "./node_modules/@cloudflare"],
    "types": ["node", "workers-types"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist"
  },
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/apps/web"]
  },
  "include": ["src"]
}
